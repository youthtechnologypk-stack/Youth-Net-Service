# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server Port (Default: 3000)
PORT=3000

# Optional PostgreSQL Database Configuration (Falls back to data/routers.json and data/router_secrets.json)
# DATABASE_URL="postgresql://user:password@localhost:5432/netpulse_isp"
# PGHOST="localhost"
# PGPORT="5432"
# PGUSER="postgres"
# PGPASSWORD="password"
# PGDATABASE="netpulse_isp"

# Optional Default MikroTik Device Configuration (Used if testing standalone CLI)
# MIKROTIK_DEFAULT_HOST="192.168.88.1"
# MIKROTIK_DEFAULT_PORT="8728"
# MIKROTIK_DEFAULT_USER="admin"
# MIKROTIK_DEFAULT_PASSWORD=""
